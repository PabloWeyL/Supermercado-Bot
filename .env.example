# Copiar a .env privado y completar los registros y credenciales reales.
CREDENCIALES_EMPRESA=WEYLAND
CREDENCIALES_VM=MVTESTING
NOMBRE_PROCESO=SUPERMERCADOS
NOMBRE_PROCESO_TEXTO=Consulta de precios de supermercados
MODULO_AUTOMATIZACION_SUPERMERCADOS=true
MODULO_CORREO=false
MODULO_CORREO_INICIAL=true
RPA_HEADLESS=true

BACKEND_AUTH_MODE=weyland
BACKEND_CONTRATO=cola_actual
BACKEND_BOT_AUTH_MODE=jwt
BACKEND_BOT_LOGIN_RUTA=/bot/sesion
BACKEND_BOT_REFRESH_RUTA=/bot/sesion/renovar
BACKEND_BOT_CERRAR_RUTA=/bot/sesion/cerrar
BACKEND_API_URL=http://127.0.0.1:8000/api
BACKEND_PERMITIR_HTTP_LOCAL=true
BACKEND_MAQUINA_ID=
BACKEND_PROCESO_CODIGO=
BACKEND_TRABAJOS_DIR=temporales/weyland
BACKEND_REUTILIZAR_ULTIMA=false
BACKEND_TIMEOUT_CONEXION=10
BACKEND_TIMEOUT_LECTURA=60
# Renovacion web y margen de renovacion del access token BOT; tokens solo en memoria.
BACKEND_REFRESH_ACTIVO=true
BACKEND_REFRESH_MARGEN_SEGUNDOS=60
WEYLAND_AUTOMATE_MVTESTING_USER=
WEYLAND_AUTOMATE_MVTESTING_PWD=

# Activar MODULO_CORREO solo despues de completar SMTP y ambas listas.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
WEYLAND_SMTP_MVTESTING_USER=
WEYLAND_SMTP_MVTESTING_PWD=
LISTA_DISTRIBUCION_ERROR=
LISTA_DISTRIBUCION_CORREO=
CORREO_MAX_INTENTOS=5
CORREO_REINTENTO_SEGUNDOS=60
MAX_ADJUNTOS_BYTES=20971520

# Limites de seguridad de la entrada.
MAX_ARCHIVO=20971520
MAX_EXPANDIDO=104857600
MAX_FILAS=50000
MAX_COLUMNAS=100

MAX_REINTENTOS=3
MAX_REINTENTOS_CORREO=3
RETENCION_LOGS_MESES=6

# Conexión local de automatización de Chrome (sin credenciales).
RPA_CHROME_URL=http://127.0.0.1:9222

# Ajustes operativos y sitios de supermercados.
BACKEND_MAX_BYTES=20971520
BACKEND_MAX_PAGINAS=100
ARCHIVO_REINTENTOS=5
MAX_PRODUCTOS_POR_BUSQUEDA=5
RPA_JS_REINTENTOS=3
RPA_DOM_REINTENTOS=2
MAX_EXCEL_ENTRADAS_ZIP=2000
SMTP_TIMEOUT=30
DB_TIMEOUT=5
CORREO_DB_TIMEOUT=10
RPA_HTTP_TIMEOUT=2
RPA_CIERRE_TIMEOUT=3
RPA_SONDEO_INTERVALO=0.2
RPA_JS_PAUSA=1
RPA_CAPTURA_PAUSA=3
RPA_RESULTADOS_INTERVALO=1.5
RPA_ESCRITURA_PAUSA=0.5
REINTENTOS_PAUSA=2
REINTENTOS_PAUSA_MAX=5
ARCHIVO_REINTENTO_PAUSA=0.05
DEPENDENCIAS_TIMEOUT=10
RPA_TIMEOUT=20
RPA_ESPERA_MAX=30
SUPERMERCADO_LIDER_URL=https://super.lider.cl/search?q={termino}
SUPERMERCADO_LIDER_ESPERA=8
SUPERMERCADO_TOTTUS_URL=https://www.tottus.cl/tottus-cl
SUPERMERCADO_TOTTUS_ESPERA=8
SUPERMERCADO_TOTTUS_ESPERA_RESULTADOS=3
SUPERMERCADO_UNIMARC_URL=https://www.unimarc.cl
SUPERMERCADO_UNIMARC_ESPERA=8
SUPERMERCADO_UNIMARC_ESPERA_RESULTADOS=3

# Opcional: ruta completa al ejecutable; vacío usa detección automática.
CHROME_PATH=

# true: solicitudes del backend; false: solo archivos Excel de CARPETA_INPUTS.
BACKEND_ACTIVO=true
CARPETA_INPUTS=input

# Límites del lote de archivos de entrada de una solicitud.
BACKEND_MAX_INPUTS=100
BACKEND_MAX_INPUTS_BYTES=104857600

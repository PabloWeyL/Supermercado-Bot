# Credenciales: administrador WEYLAND, empresa del ejemplo WEYLAND, VM MVTESTING.
CREDENCIALES_EMPRESA=WEYLAND
CREDENCIALES_VM=MVTESTING
# Perfil para el backend Django real; agregar variables al .env propio.
BACKEND_AUTH_MODE=weyland
# Contrato del backend vigente. Registrar la VM y completar su ID real; no usar un ID inventado.
BACKEND_CONTRATO=cola_actual
BACKEND_MAQUINA_ID=
# Opcional: contexto de empresa para las consultas de conciliacion por sesion.
# BACKEND_EMPRESA_ID=
# python main.py: valida todo y luego toma la siguiente EN_COLA de esa VM.
ARRANQUE_MODO=web
# Solo para el contrato anterior BACKEND_CONTRATO=por_id:
# BACKEND_SOLICITUD_ID=
# Exclusivos del simulador local. Obligatorios para probar_flujo_web; no seleccionan solicitudes reales.
ID_PRUEBA=900001
CODIGO_PRUEBA='SUPERMERCADOS_PRUEBA'
# Opcionales. Cola privada compartida por ejecuciones y reintentos de correo.
# CORREO_PENDIENTES_DIR=C:/Procesos/Supermercados/correos
CORREO_MAX_INTENTOS=5
CORREO_REINTENTO_SEGUNDOS=60
# Limite acumulado de adjuntos de cada correo, en bytes (20 MiB).
MAX_ADJUNTOS_BYTES=20971520
# Limites obligatorios de entrada: tamanos en bytes; filas sin encabezado.
MAX_ARCHIVO=20971520
MAX_EXPANDIDO=104857600
MAX_FILAS=50000
MAX_COLUMNAS=100
BACKEND_API_URL=http://127.0.0.1:8000/api
BACKEND_LOGIN_URL=http://127.0.0.1:8000/api/auth/login
BACKEND_PERMITIR_HTTP_LOCAL=true
# HTTP solo se permite en loopback y con esta bandera. Produccion requiere HTTPS.
BACKEND_PROCESO_CODIGO=
BACKEND_TRABAJOS_DIR=temporales/weyland
# Ejecutar solo el ID seleccionado por el operador; no crear ni repetir solicitudes.
BACKEND_REUTILIZAR_ULTIMA=false
# Completar solo en .env privado o inyectar en entorno. No compartir secretos.
WEYLAND_AUTOMATE_MVTESTING_USER=
WEYLAND_AUTOMATE_MVTESTING_PWD=
WEYLAND_AUTOMATE_MVTESTING_API_KEY=
# WEYLAND_AUTOMATE_MVTESTING_API_KEY debe coincidir con BOT_API_KEY del servidor.

# Tiempos HTTP configurables por maquina, en segundos.
BACKEND_TIMEOUT_CONEXION=10
BACKEND_TIMEOUT_LECTURA=60

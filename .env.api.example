# Credenciales: administrador WEYLAND, empresa del ejemplo WEYLAND, VM MVTESTING.
CREDENCIALES_EMPRESA=WEYLAND
CREDENCIALES_VM=MVTESTING
# Agregar estas variables al .env del bot o inyectarlas en el entorno.
# En la VM, obtener WEYLAND_AUTOMATE_MVTESTING_PWD desde el gestor de secretos.
# El backend actual usa cookies/CSRF, no JWT.
BACKEND_AUTH_MODE=weyland
BACKEND_CONTRATO=cola_actual
BACKEND_API_URL=https://backend.example.com/api
BACKEND_LOGIN_URL=https://backend.example.com/api/auth/login
# Completar ambos con los registros reales de la plataforma.
BACKEND_MAQUINA_ID=
BACKEND_PROCESO_CODIGO=
WEYLAND_AUTOMATE_MVTESTING_USER=bot-supermercados@example.test
WEYLAND_AUTOMATE_MVTESTING_PWD=
WEYLAND_AUTOMATE_MVTESTING_API_KEY=

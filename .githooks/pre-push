#!/bin/sh
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
    if [ -x .venv/Scripts/python.exe ]; then
        .venv/Scripts/python.exe tools/verificar_publicacion.py --revision "$local_oid" || exit 1
    elif command -v python3 >/dev/null 2>&1; then
        python3 tools/verificar_publicacion.py --revision "$local_oid" || exit 1
    else
        python tools/verificar_publicacion.py --revision "$local_oid" || exit 1
    fi
done
